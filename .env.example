APP_NAME=SmartER API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://smarter:CHANGE_ME@localhost:5432/smarter
BACKEND_CORS_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_DB=smarter
POSTGRES_USER=smarter
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional development seed values. Set passwords before running the seed command.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=
DEMO_TRIAGE_EMAIL=triage@example.com
DEMO_TRIAGE_PASSWORD=
DEMO_HEALTH_AUTHORITY_EMAIL=authority@example.com
DEMO_HEALTH_AUTHORITY_PASSWORD=